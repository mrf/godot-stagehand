{
  // Type-checks the mod in integrations/claude-code/hooks against the
  // declarations the pinned CLI's plugin-authoring skill carries, which
  // `npm run types` copies to .cc-types/. As that file's header says for a
  // `claude -p` host, this tsconfig sits outside the mod folder and its include
  // names the file and the mod's hooks. The file is per CLI build and never
  // committed (design Q10).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "esnext.typedarrays"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "types": []
  },
  "include": [".cc-types/claude-code.d.ts", "../../integrations/claude-code/hooks/**/*.ts"]
}
