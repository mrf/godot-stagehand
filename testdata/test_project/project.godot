; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited directly using a text editor.

[application]

config/name="Stagehand Test Project"
run/main_scene="res://scenes/test_scene.tscn"

[autoload]

StagehandServer="*res://addons/stagehand/autoload/stagehand_server.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/unused_private_class_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/unused_signal=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/return_value_discarded=2
gdscript/warnings/static_called_on_instance=2
gdscript/warnings/redundant_await=2
gdscript/warnings/assert_always_true=2
gdscript/warnings/assert_always_false=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/untyped_declaration=2
; The addon under test lives in res://addons, so addon warnings must count.
; Godot excludes res://addons from warnings by default and changed the knob
; mid-4.x, so BOTH must be set for the 4.3-4.7 CI matrix:
;   4.3-4.5  honour `exclude_addons` (directory_rules does not exist).
;   4.6+     dropped `exclude_addons` and gate on `directory_rules`, whose
;            default is {"res://addons": 0} -- level 0 means "ignore".
; Setting only one of them silently disarms the gate on the other half of the
; matrix. Also note the `;` above: project.godot is a ConfigFile, where `#`
; does NOT start a comment -- a `#` line is glued onto the next key, which is
; exactly how this exclusion went unnoticed (godot-stagehand-wan).
;
; gdUnit4 is vendored third-party code that does not meet this bar (30
; inferred_declaration warnings), and the GdUnit4 job loads it for real, so it
; keeps level 0. On 4.3-4.5 `exclude_addons=false` has no per-directory
; equivalent and gates gdUnit4 too -- harmless, because the only jobs on those
; versions load the autoload and main scene, never gdUnit4's runner.
gdscript/warnings/exclude_addons=false
gdscript/warnings/directory_rules={
"res://addons/gdUnit4": 0
}

[editor_plugins]

enabled=PackedStringArray("res://addons/stagehand/plugin.cfg")
