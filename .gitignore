
# Beads / Dolt files (added by br init)
.dolt/
*.db
.beads-credential-key

# Go
/godot-stagehand
*.exe
*.test
*.out

# Godot
.godot/
*.import
export_presets.cfg
# Godot 4.4+ regenerates .uid sidecars on every headless import. They are
# derived artifacts, and any that land under testdata/test_project/addons/
# stagehand would break TestFixtureAddonCopiesMatchCanonical's byte-for-byte
# fixture check (docs/addon-sync-contract.md). Never track them.
*.uid

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
testdata/test_project/.godot/
# GdUnit4 writes a fresh reports/report_<n>/ tree on every headless run.
testdata/test_project/reports/

# agents
.pi
.claude
.codex

# Orchestrator worktree artifacts (must never be tracked — a committed
# sentinel poisons every new worktree with a false "done" signal)
.orchestrator-done
.orchestrator-note
.orchestrator-findings.jsonl
.orchestrator-findings.harvested.jsonl
