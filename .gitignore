
# Beads / Dolt files (added by br init)
.dolt/
*.db
.beads-credential-key

# Go
/godot-stagehand
*.exe
*.test
*.out

# Godot
.godot/
*.import
export_presets.cfg
# .uid sidecars (Godot 4.4+) are deliberately tracked, not ignored: Godot's
# own guidance is that they must ship with the project, since a UID assigned
# on one machine and never committed leaves every other clone with `ext_resource`
# links Godot can't resolve until the editor re-imports and reassigns them
# (the "invalid UID" warning). See docs/addon-sync-contract.md.

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
testdata/test_project/.godot/
# GdUnit4 writes a fresh reports/report_<n>/ tree on every headless run.
testdata/test_project/reports/

# agents
.pi
.claude
.codex

# Orchestrator worktree artifacts (must never be tracked — a committed
# sentinel poisons every new worktree with a false "done" signal)
.orchestrator-done
.orchestrator-note
.orchestrator-findings.jsonl
.orchestrator-findings.harvested.jsonl

# Scenario runner output. --out-dir is arbitrary, so these cover the
# conventional names the docs and CI use; a project checking in its own
# baselines should keep stagehand-baselines/ tracked deliberately.
/scenario-artifacts/
/ci-artifacts/
/stagehand-diffs/

# Host-project compatibility suite checkouts. Third-party projects are cloned
# at their pinned SHA into here; the manifest in testdata/hostcompat/ is the
# only checked-in record of them. See docs/design/host-project-compat-suite.md.
/.hostcompat/

# Go CI Report Card output (reportcard/generate.py --output _site)
/_site/
__pycache__/
*.pyc

# Cross-compiled release binaries produced by build-release.sh
/build/
